# ---- Generator LLM (Groq) -------------------------------------------------
# Get a key at https://console.groq.com/keys. Without it the service still runs but
# answers degrade to a clearly-labelled verbatim passage (generation_mode=extractive_fallback).
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
# Judge for the answer-quality evaluation; keep it a DIFFERENT model family from the generator.
JUDGE_MODEL=openai/gpt-oss-120b

# ---- Vector store ---------------------------------------------------------
DEFAULT_VECTOR_STORE=lancedb          # lancedb | qdrant
LANCEDB_DIR=./data/lancedb
QDRANT_DIR=./data/qdrant

# ---- Embeddings (local ONNX via fastembed; no API cost) ---------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# ---- Ingestion defaults ---------------------------------------------------
DEFAULT_CHUNK_SIZE=500                # characters
DEFAULT_CHUNK_OVERLAP=50              # characters
MAX_UPLOAD_MB=10
CORPUS_DIR=./data/corpus

# ---- Retrieval ------------------------------------------------------------
# Min cosine similarity of the best chunk to attempt an answer (else "no relevant context").
SIMILARITY_THRESHOLD=0.68

# ---- Server / security ----------------------------------------------------
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*                        # comma-separated origins; set to the frontend URL in production
ADMIN_TOKEN=                          # if set, /ingest* and /llm-status require header X-Admin-Token
